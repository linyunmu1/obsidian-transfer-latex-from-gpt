 // 替换函数：将 $ ... $ 替换为 $ ... $(去掉前后空格)
 convertLatexSyntax(content) {
    const inlineRegex = /\$\s*(.*?)\s*\$/gs;
    let updatedContent = content.replace(inlineRegex, (match, formula) => `$${formula.trim()}$`);
    return updatedContent;
  }
